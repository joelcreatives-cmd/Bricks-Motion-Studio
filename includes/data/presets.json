{
  "fade":            { "label": "Fade in",                  "group": "reveal", "from": { "opacity": 0 } },
  "fade-up":         { "label": "Fade up",                  "group": "reveal", "from": { "opacity": 0, "y": "d" } },
  "fade-down":       { "label": "Fade down",                "group": "reveal", "from": { "opacity": 0, "y": "-d" } },
  "fade-left":       { "label": "Fade in from right",       "group": "reveal", "from": { "opacity": 0, "x": "d" } },
  "fade-right":      { "label": "Fade in from left",        "group": "reveal", "from": { "opacity": 0, "x": "-d" } },
  "zoom-in":         { "label": "Zoom in",                  "group": "reveal", "from": { "opacity": 0, "scale": 0.85 } },
  "zoom-out":        { "label": "Zoom out",                 "group": "reveal", "from": { "opacity": 0, "scale": 1.12 } },
  "flip-up":         { "label": "Flip up (3D)",             "group": "reveal", "from": { "opacity": 0, "rotateX": 65, "perspective": 1000 }, "origin": "50% 100%" },
  "flip-left":       { "label": "Flip from left (3D)",      "group": "reveal", "from": { "opacity": 0, "rotateY": -65, "perspective": 1000 }, "origin": "0% 50%" },
  "rotate-in":       { "label": "Rotate in",                "group": "reveal", "from": { "opacity": 0, "rotate": -5, "y": "d" }, "origin": "0% 100%" },
  "skew-up":         { "label": "Skew up",                  "group": "reveal", "from": { "opacity": 0, "y": "d", "skewY": 4 } },
  "blur-in":         { "label": "Blur in",                  "group": "reveal", "from": { "opacity": 0, "blur": 14 } },
  "blur-up":         { "label": "Blur up",                  "group": "reveal", "from": { "opacity": 0, "blur": 10, "y": "d" } },
  "clip-up":         { "label": "Wipe up (clip)",           "group": "reveal", "from": { "clip": [100, 0, 0, 0] }, "to": { "clip": [0, 0, 0, 0] } },
  "clip-down":       { "label": "Wipe down (clip)",         "group": "reveal", "from": { "clip": [0, 0, 100, 0] }, "to": { "clip": [0, 0, 0, 0] } },
  "clip-left":       { "label": "Wipe left (clip)",         "group": "reveal", "from": { "clip": [0, 0, 0, 100] }, "to": { "clip": [0, 0, 0, 0] } },
  "clip-right":      { "label": "Wipe right (clip)",        "group": "reveal", "from": { "clip": [0, 100, 0, 0] }, "to": { "clip": [0, 0, 0, 0] } },
  "reveal-image":    { "label": "Image reveal (clip + zoom)", "group": "reveal", "from": { "clip": [100, 0, 0, 0], "scale": 1.25 }, "to": { "clip": [0, 0, 0, 0], "scale": 1 }, "duration": 1.2 },

  "split-lines":     { "label": "Lines slide up (masked)", "group": "text", "split": "lines", "mask": true, "from": { "y": "100%" }, "stagger": 0.1, "duration": 0.9 },
  "split-words":     { "label": "Words fade up",      "group": "text", "split": "words", "from": { "opacity": 0, "y": "hd" }, "stagger": 0.05 },
  "split-words-blur":{ "label": "Words blur in",      "group": "text", "split": "words", "from": { "opacity": 0, "blur": 8 }, "stagger": 0.05 },
  "split-chars":     { "label": "Characters fade up", "group": "text", "split": "chars", "from": { "opacity": 0, "y": "hd" }, "stagger": 0.02, "duration": 0.6 },
  "typewriter":      { "label": "Typewriter",         "group": "text", "split": "chars", "from": { "opacity": 0 }, "stagger": 0.035, "duration": 0.01, "ease": "linear" },
  "scramble":        { "label": "Scramble (GSAP)",    "group": "text", "engines": ["gsap"], "plugins": ["ScrambleTextPlugin"], "fallback": "split-chars", "duration": 1.4 },
  "scroll-highlight":{ "label": "Highlight words on scroll", "group": "text", "split": "words", "core": true, "hide": false },

  "parallax":        { "label": "Parallax (vertical)",      "group": "scroll", "scrub": true, "from": { "y": "p" }, "to": { "y": "-p" }, "range": "full" },
  "parallax-x":      { "label": "Parallax (horizontal)",    "group": "scroll", "scrub": true, "from": { "x": "p" }, "to": { "x": "-p" }, "range": "full" },
  "scroll-fade":     { "label": "Fade in while scrolling",  "group": "scroll", "scrub": true, "from": { "opacity": 0 }, "to": { "opacity": 1 }, "range": "enter" },
  "scroll-scale":    { "label": "Scale up while scrolling", "group": "scroll", "scrub": true, "from": { "scale": 0.8 }, "to": { "scale": 1 }, "range": "enter" },
  "scroll-rotate":   { "label": "Rotate while scrolling",   "group": "scroll", "scrub": true, "from": { "rotate": -12 }, "to": { "rotate": 12 }, "range": "full" },
  "scroll-expand":   { "label": "Expand while scrolling (clip)", "group": "scroll", "scrub": true, "from": { "clip": [8, 12, 8, 12] }, "to": { "clip": [0, 0, 0, 0] }, "range": "enter" },
  "horizontal-scroll": { "label": "Horizontal scroll (pinned, GSAP)", "group": "scroll", "engines": ["gsap"], "pin": true },
  "pin":             { "label": "Pin while scrolling (GSAP)", "group": "scroll", "engines": ["gsap"], "pin": true },

  "float":           { "label": "Float",              "group": "loop", "loop": true, "from": { "y": 0 }, "to": { "y": -14 }, "duration": 3, "ease": "sine", "yoyo": true },
  "pulse":           { "label": "Pulse",              "group": "loop", "loop": true, "from": { "scale": 1 }, "to": { "scale": 1.06 }, "duration": 1.6, "ease": "sine", "yoyo": true },
  "sway":            { "label": "Sway",               "group": "loop", "loop": true, "from": { "rotate": -3 }, "to": { "rotate": 3 }, "duration": 2.4, "ease": "sine", "yoyo": true },
  "spin":            { "label": "Spin",               "group": "loop", "loop": true, "from": { "rotate": 0 }, "to": { "rotate": 360 }, "duration": 14, "ease": "linear", "yoyo": false },
  "marquee": { "label": "Marquee (slides sideways forever)", "group": "loop", "loop": true, "from": { "x": "0%" }, "to": { "x": "-100%" }, "duration": 20, "ease": "linear", "yoyo": false },

  "counter":         { "label": "Count up numbers",         "group": "special", "core": true, "duration": 2 },
  "draw-svg":        { "label": "Draw SVG strokes",         "group": "special", "draw": true, "duration": 1.6, "ease": "in-out" }
}
