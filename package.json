{
  "name": "bricks-motion-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-library animation engine for Bricks Builder (build tooling).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "vendor": "node bin/vendor.mjs",
    "build:three": "node bin/build-three.mjs",
    "build:js": "node bin/build-js.mjs",
    "build": "npm run vendor && npm run build:three && npm run build:js",
    "check": "node bin/check.mjs",
    "zip": "bash bin/package.sh",
    "test:e2e": "node tests/e2e/run.mjs && BUILD=min node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "animejs": "4.5.0",
    "esbuild": "^0.25.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "motion": "13.4.5",
    "three": "0.186.1",
    "puppeteer-core": "^24.0.0"
  }
}
